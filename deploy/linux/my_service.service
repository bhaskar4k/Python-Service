[Unit]
Description=My Python Service (supervisor + workers)
After=network.target

[Service]
Type=simple
User=myservice
WorkingDirectory=/opt/my_service
Environment=PYTHONUNBUFFERED=1
Environment=MY_SERVICE_LOG_DIR=/var/log/my_service
ExecStart=/opt/my_service/venv/bin/python main.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
